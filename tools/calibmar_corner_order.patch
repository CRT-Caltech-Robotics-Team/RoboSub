+++ b/src/calibmar/extractors/aruco_board_extractor.cpp
@@ -1,6 +1,33 @@
 #include "calibmar/extractors/aruco_board_extractor.h"

+#include <stdexcept>
+
 namespace {
+  int AprilTagCornerShift() {
+    // Calibmar needs a top-left corner origin across OpenCV versions.
+    auto dictionary = cv::aruco::getPredefinedDictionary(
+        cv::aruco::DICT_APRILTAG_36h11);
+    cv::Mat marker, image;
+    cv::aruco::drawMarker(dictionary, 0, 160, marker);
+    cv::copyMakeBorder(marker, image, 20, 20, 20, 20,
+                       cv::BORDER_CONSTANT, cv::Scalar(255));
+    std::vector<std::vector<cv::Point2f>> corners;
+    std::vector<int> ids;
+    cv::aruco::detectMarkers(image, dictionary, corners, ids);
+    if (ids.size() != 1 || corners.size() != 1 ||
+        corners[0].size() != 4) {
+      throw std::runtime_error("Cannot determine AprilTag corner order");
+    }
+    int shift = 0;
+    for (int i = 1; i < 4; ++i) {
+      if (corners[0][i].x + corners[0][i].y <
+          corners[0][shift].x + corners[0][shift].y) {
+        shift = i;
+      }
+    }
+    return shift;
+  }
+
   bool CloseToBorder(const cv::Point2f& corner, int min_distance, int image_width, int image_height) {
     return corner.x < min_distance || corner.y < min_distance || corner.x > image_width - min_distance ||
            corner.y > image_height - min_distance;
