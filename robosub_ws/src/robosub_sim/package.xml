<?xml version="1.0"?>
<package format="3">
  <name>robosub_sim</name>
  <version>0.1.0</version>
  <description>Minimal RoboSub AUV simulation: Gazebo Harmonic pool world, ROS 2 bridge, control allocation.</description>
  <maintainer email="timzhang2018@gmail.com">crt</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <export><build_type>ament_python</build_type></export>
</package>
